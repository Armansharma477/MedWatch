# Backend Environment Variables
# Server Configuration
PORT=5000
NODE_ENV=development

# Frontend URL (for CORS)
# Allow any localhost port for development
FRONTEND_URL=http://localhost:5176

# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017/adr-platform

# JWT Secret (generate a strong random string for production)
JWT_SECRET=medwatch-super-secret-jwt-key-2024-change-in-production

# JWT Expiration
JWT_EXPIRE=7d

# Stripe Configuration (Test Mode)
# Replace with your actual Stripe test keys from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Email Configuration (Optional)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
